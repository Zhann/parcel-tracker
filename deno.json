{
  "tasks": {
    "tui": "deno run --allow-run=swamp,setsid --allow-env --allow-read --allow-write=logs tui/main.ts",
    "test": "deno test --allow-read extensions/models/ extensions/reports/ tui/",
    "check": "deno fmt --check && deno lint && deno check extensions/models/*.ts extensions/models/_lib/*.ts extensions/reports/*.ts tui/*.ts"
  },
  "fmt": {
    "lineWidth": 100,
    "include": [
      "extensions/",
      "tui/"
    ],
    "exclude": [
      "extensions/models/fixtures/"
    ]
  },
  "lint": {
    "include": [
      "extensions/",
      "tui/"
    ],
    "rules": {
      "exclude": [
        "no-import-prefix"
      ]
    }
  }
}
